configuration {
        display-drun: "Start ->";
        display-window: "Windows ->";
        display-run: "Run ->";
        drun-display-format: "{icon} {name}";
        font: "JetBrains Mono Medium 13";
        modi: "window,run,drun";
        show-icons: true;

}

@theme "/dev/null"

* {
        border-colour: #b4befe;
        alternate-colour: #FFFFFF;
        foreground-colour: #FFFFFF;
        text-colour: #cad3f5;
        handle-colour: #313244;

        normal-background: #8839ef;
        normal-foreground: #df8e1d;


}

window {
        transparency: "real";
        fullscreen: false;
        location: center;
        anchor: center;
        width: 600px;

        enabled: true;
        border: 4px solid;
        border-radius: 4px;
        border-color: #babbf1;
        background-color: transparent;

}

//**MAIN BOX**//
mainbox {
        enabled: true;
        spacing: 0px;
        margin: 0px;
        padding: 0px;
        border: 0px solid;
        border-color: @border-colour;
        background-color: #494d64;
        children: [ "inputbar", "message", "listview", "mode-switcher" ];
}
//**INPUT BAR**//
inputbar {
        enabled: true;
        spacing: 5px;
        margin: 0px;
        padding: 10px;
        border: 0px 0px 0px 0px;
        border-radius: 0px;
        border-color: @border-colour;
        background-color: #1e1e2e;
        text-color: @text-colour;
        children: [ "prompt", "entry" ];
}

prompt {
        enabled: true;
        background-color: inherit;
        text-color: inherit;
}

textbox-prompt-colon {
        enabled: true;
        expand: false;
        str: "::";
        background-color: inherit;
        text-color: inherit;
}

entry {
        enabled: true;
        background-color: inherit;
        text-color: inherit;
        cursor: text;
        placeholder: "";
        placeholder-color: inherit;
}

//**LISTVIEW**//
listview {
        enabled: true;
        columns: 1;
        lines: 4;
        cycle: true;
        dynamic: true;
        scrollbar: true;
        layout: vertical;
        reverse: false;
        fixed-height: true;
        fixed-columns: true;

        spacing: 0px;
        margin: 0px;
        padding: 0px;
        border: 0px solid;
        border-radius: 0px;
        border-color: @border-colour;
        background-color: transparent;
        text-color: @text-colour;
        cursor: "default";
}
scrollbar {
        handle-width: 5px;
        handle-color: @handle-colour;
        border-radius: 0px;
        background-color: @alternate-colour;
}

element {
        enabled: true;
        spacing: 5px;
        margin: 0px;
        padding: 10px;
        border: 0px solid;
        border-radius: 0px;
        border-color: @border-colour;
        background-color: transparent;
        text-color: @text-colour;
        cursor: pointer;




}
element normal.normal {
    background-color:            #494d64;
    text-color:                  #cdd6f4;
}
element normal.urgent {
    background-color:            #494d64;
    text-color:                  #cdd6f4;
}
element normal.active {
    background-color:            #494d64;
    text-color:                  #cdd6f4;
}
element selected.normal {
    background-color:            #6c7086;
    text-color:                  #cdd6f4;
}
element selected.urgent {
    background-color:            #6c7086;
    text-color:                  #cdd6f4;
}
element selected.active {
    background-color:            #6c7086;
    text-color:                  #cdd6f4;
}
element alternate.normal {
    background-color:            #494d64;
    text-color:                  #cdd6f4;
}
element alternate.urgent {
    background-color:            #494d64;
    text-color:                  #cdd6f4;
}
element alternate.active {
    background-color:            #494d64;
    text-color:                  #cdd6f4;
}
element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        24px;
    cursor:                      inherit;
}
element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

//**MODESWITCHER**//
mode-switcher {
        enabled: false;
        spacing: 10px;
        margin: 0px;
        padding: 0px;
        border: 0px solid;
        border-radius: 4px;
        border-color: @border-colour;
        background-color: transparent;
        text-color: @text-colour;
}

button {
        padding: 5px;
        border: 1px solid;
        border-radius: 4px;
        border-color: @border-colour;
        background-color: @alternate-colour;
        text-color: inherit;
        cursor: pointer;
}
button selected {
        background-color: #89dceb;
        text-color: #89dceb;
}
//**Message**//
message {
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px 0px 0px 0px;
    border-color:                @border-colour;
    background-color:            transparent;
    text-color:                  @text-colour;
}
textbox {
    padding:                     10px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @border-colour;
    background-color:            @alternate-colour;
    text-color:                  @text-colour;
    vertical-align:              0.5;
    horizontal-align:            0.0;
    highlight:                   none;
    placeholder-color:           @foreground-colour;
    blink:                       true;
    markup:                      true;
}
error-message {
    padding:                     10px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @border-colour;
    background-color:            @alternate-colour;
    text-color:                  @text-colour;
}
